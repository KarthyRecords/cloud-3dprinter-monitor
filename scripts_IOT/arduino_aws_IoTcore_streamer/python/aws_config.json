  "snapshot_interval_s": 8,
  "snapshot_max_kb": 120,
  "snapshot_max_width": 640,
  "sensor_names": [
    "table",
    "toolhead"
  ],
  "queue": {
    "db_path": "aws_queue.db",
    "max_rows": 200000
  },
  "max_inflight": 20,
  "ack_timeout_s": 30
